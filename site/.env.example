# Local development only. Production uses a Sites secret generated during deployment.
# Generate 32 random bytes encoded as 64 hexadecimal characters. Never commit the real key.
AGENT_VAULT_KEY=
# Dedicated Robinhood mainnet RPC for server-side authorization and reads.
# Robinhood recommends Alchemy for production. Keep the endpoint secret when it contains an API key.
ROBINHOOD_RPC_URL=
